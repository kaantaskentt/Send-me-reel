TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional native YouTube reader; the key stays on the server.
CONTEXTDROP_GEMINI_VIDEO_MODEL=gemini-3.5-flash-lite
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Dashboard auth (same secret in web/.env.local)
JWT_SECRET=
# Use a distinct shared secret on worker and web for media downloads.
MEDIA_PROXY_SECRET=
APP_URL=https://contextdrop.app

# Apify fallback scraper (used when yt-dlp fails)
APIFY_TOKEN=

# Local guided browser planner (uses OPENAI_API_KEY above)
COMPUTER_MODEL=gpt-5.4-mini

# Optional local Terminal runner. Interactive is the default.
# Exec streams commands/results and saves a final response for review.
CONTEXTDROP_TERMINAL_MODE=interactive
CONTEXTDROP_CODEX_MODEL=gpt-5.4-mini
LOCAL_STUDIO_ORIGIN=http://127.0.0.1:3127
