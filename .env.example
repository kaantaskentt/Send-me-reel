TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Dashboard auth (same secret in web/.env.local)
JWT_SECRET=
APP_URL=https://contextdrop.app

# Apify fallback scraper (used when yt-dlp fails)
APIFY_TOKEN=

# Per-user LLM Wiki sidecar (PR2+ feature). Default off; set "true" to enqueue.
WIKI_COMPILER_ENABLED=false
