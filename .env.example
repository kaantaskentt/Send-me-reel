TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Dashboard auth (same secret in web/.env.local)
JWT_SECRET=
# Use a distinct shared secret on worker and web for media downloads.
MEDIA_PROXY_SECRET=
APP_URL=https://contextdrop.app

# Apify fallback scraper (used when yt-dlp fails)
APIFY_TOKEN=

# Local guided browser planner (uses OPENAI_API_KEY above)
COMPUTER_MODEL=gpt-5.4-mini
