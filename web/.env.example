# Server-only settings. Keep this file's values out of the browser bundle.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
JWT_SECRET=
OPENAI_API_KEY=
GEMINI_API_KEY=
CONTENT_CHAT_MODEL=gpt-5.4-mini
APP_URL=http://localhost:3000
REPLICATION_MODEL=gpt-5.4-mini
# Match the worker's MEDIA_PROXY_SECRET when using CDN download fallback.
MEDIA_PROXY_SECRET=

# Explicit opt-in to the loopback-only development studio. Never enabled in production.
CONTEXTDROP_LOCAL_STUDIO=0
